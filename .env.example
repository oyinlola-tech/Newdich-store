# ===== Server =====
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api
CORS_ORIGIN=*

# ===== Database (MySQL / MariaDB) =====
DATABASE_URL="mysql://root:Oyinlola@localhost:3306/newdich_store"

# ===== Auth =====
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
OTP_REQUIRED=true
OTP_LIFETIME_MINUTES=10

# ===== Superadmin (created during database seed) =====
ADMIN_EMAIL=admin@newdich.com
ADMIN_PASSWORD=ChangeMe_Admin123
ADMIN_NAME=Super Admin
ADMIN_PHONE=

# ===== Media / uploads =====
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=10
PUBLIC_BASE_URL=http://localhost:3000

# ===== Email (console prints OTP/reset links to logs in dev) =====
EMAIL_PROVIDER=console
RESEND_API_KEY=

# ===== Optional integrations (later milestones) =====
REDIS_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
