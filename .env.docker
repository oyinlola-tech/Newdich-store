# Docker-specific environment variables
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database
DB_ROOT_PASSWORD=change-me-in-production
DB_NAME=telente_store
DB_USER=telente
DB_PASSWORD=change-me-in-production
DB_PORT=3306

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
OTP_REQUIRED=true
OTP_LIFETIME_MINUTES=10

# Superadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
ADMIN_NAME=Super Admin
ADMIN_PHONE=

# Media
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=10
PUBLIC_BASE_URL=http://localhost:3000

# Email
EMAIL_PROVIDER=console
RESEND_API_KEY=
SEND_BYTE_API_KEY=
SEND_BYTE_BASE_URL=https://api.sendbyte.africa
SEND_BYTE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=
EMAIL_FROM=Telente Store <no-reply@telente.site>

# Integrations
REDIS_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
NOMBA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPPING_PROVIDER=
SHIPPING_API_KEY=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=600000
LOG_LEVEL=info
